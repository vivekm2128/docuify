# Copy this file to .env and adjust as needed.

# --- Local LLM (Ollama) ---
DOCUFY_LLM_MODEL=qwen3.5:4b-mlx
DOCUFY_LLM_URL=http://127.0.0.1:11434
DOCUFY_LLM_TIMEOUT=300
DOCUFY_LLM_NUM_CTX=8192
DOCUFY_LLM_TEMPERATURE=0
# Thinking models (qwen3) spend seconds on hidden reasoning before the JSON.
# 0 turns that off; 1 turns it back on for models that need it.
DOCUFY_LLM_THINK=0
# Hard cap on the answer length, so a runaway generation cannot run for minutes.
DOCUFY_LLM_NUM_PREDICT=1200
# Optional second model, used only for fields the first pass could not find in
# the document (a blank field, or a value not on the page). Empty = off.
# It made no accuracy difference on the bundled samples and added ~13s per
# document, so leave it off unless your own documents come back with gaps.
DOCUFY_LLM_FALLBACK_MODEL=

# --- OCR ---
DOCUFY_OCR_MAX_DIM=2200
DOCUFY_MAX_PAGES=20

# --- Server ---
DOCUFY_HOST=127.0.0.1
DOCUFY_PORT=8765
DOCUFY_MAX_UPLOAD_MB=50
# Only the first N characters of OCR text go to the model.
DOCUFY_MAX_CHARS=14000
